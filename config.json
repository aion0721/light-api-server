{
  "port": 3000,
  "host": "0.0.0.0",
  "resources": ["fruit", "meat"],
  "idField": "id",
  "maxBodyBytes": 1000000,
  "cors": {
    "origin": "*",
    "headers": "Origin, X-Requested-With, Content-Type, Accept",
    "methods": "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  },
  "https": {
    "enabled": false,
    "keyFile": "./certs/server.key",
    "certFile": "./certs/server.crt"
  }
}
